# ---- Server ----------------------------------------------------------------
# The address people use to reach this app (needed for Gmail sign-in redirects + secure cookies)
PUBLIC_URL=http://localhost:8000
# If set, new accounts need this code to sign up (keeps strangers out of a hosted copy)
SNIPER_INVITE_CODE=
# Encrypts stored Gmail tokens. Leave blank to auto-generate into .sniper_secret
SNIPER_SECRET_KEY=
# Lets a deploy pipeline post update notices over HTTP (leave blank to allow only the CLI)
SNIPER_ADMIN_TOKEN=
# SNIPER_DB=sniper.db
# SNIPER_MAX_WATCHES=25

# ---- Marketplaces (all free; set the ones you have) -------------------------
# eBay Browse API (production keyset) - https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Best Buy Products API - https://developer.bestbuy.com
BESTBUY_API_KEY=

# Walmart Affiliate API - https://walmart.io (upload your public key, keep the private one here)
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
WALMART_PRIVATE_KEY_PATH=
# WALMART_PUBLISHER_ID=

# Reddit (r/buildapcsales deals + r/hardwareswap used parts) - reddit.com/prefs/apps, type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=price-sniper/0.1 (by u/yourname)

# Reverb - reverb.com > Settings > API & Integrations > personal token
REVERB_TOKEN=

# Etsy Open API v3 - https://www.etsy.com/developers
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Gmail alert emails (Craigslist/OfferUp/Mercari/Facebook...) - Google Cloud OAuth client
# Authorized redirect URI must be: <PUBLIC_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 1 = always include the simulated Demo source, 0 = never (default: only when nothing else is configured)
# SNIPER_DEMO=

# ---- Push ------------------------------------------------------------------
# Each user sets their own ntfy topic / Discord webhook in Settings.
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
